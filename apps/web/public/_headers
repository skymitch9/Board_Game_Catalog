# Cloudflare Assets reads this at deploy time. Vite copies public/ into dist/.
#
# The problem it solves: index.html names the hashed bundles, so a stale copy of
# it points a phone at last deploy's JavaScript forever. Safari held onto it
# across a deploy and kept rendering the previous build — the assets were new,
# the file naming them was not.
#
# So: never trust a cached index.html, and always trust a hashed asset.

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

# Content-hashed by Vite, so the name changes whenever the bytes do. Safe to keep
# for a year, and `immutable` stops the browser revalidating on every load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ⚠️ The estate theme assets are copied in verbatim (not content-hashed), so
# they must NOT inherit the year-long immutable rule above — a phone would pin
# the first theme css it ever saw across every future re-theme. Later rules
# override earlier ones for the same header. The fonts stay immutable: a face
# never changes bytes without changing name.
/assets/estate-theme.css
  Cache-Control: no-cache
/assets/theme.js
  Cache-Control: no-cache

# ⚠️ Same rule, same reason, for the materialised <estate-search> component
# (scripts/sync-estate-search.mjs writes apps/web/public/estate/). It is copied
# in verbatim from catalog-platform and is NOT content-hashed, so it must
# revalidate — the whole point of the shared component is that an improvement
# made upstream reaches this site, and a year-long cache would defeat that for
# every browser that ever loaded the old one. It sits outside /assets/ so it
# does not inherit the immutable rule in the first place; this line is the
# belt to that braces.
/estate/*
  Cache-Control: no-cache
